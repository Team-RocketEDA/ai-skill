  "target_level": "transistor",
  "requirements": [
    {
      "id": "R1",
      "text": "8-bit ALU supports addition and subtraction on operands a and b.",
      "source": "user",
      "acceptance": [
        "y == (a + b) mod 256 when opcode selects ADD",
        "y == (a - b) mod 256 when opcode selects SUB"
      ]
    },
    {
      "id": "R2",
      "text": "The ALU supports bitwise AND, OR, XOR and NOT.",
      "source": "user",
      "acceptance": [
        "y == a & b, a | b, a ^ b for the matching opcode",
        "y == ~a for the NOT opcode"
      ]
    },
    {
      "id": "R3",
      "text": "A 3-bit opcode selects exactly one operation.",
      "source": "user",
      "acceptance": [
        "each of the six defined opcodes produces its operation",
        "undefined opcodes produce y == 0"
      ]
    },
    {
      "id": "R4",
      "text": "Zero and carry flags reflect the current result.",
      "source": "user",
      "acceptance": [
        "zero == 1 exactly when y == 0",
        "carry == 1 exactly when addition or subtraction overflows 8 bits"
      ]
    },
    {
      "id": "R5",
      "text": "Operands and result are 8 bits; opcode is 3 bits.",
      "source": "user",
      "acceptance": [
        "all data ports are 8 bits wide",
        "opcode is 3 bits wide"
      ]
    }
  ],
